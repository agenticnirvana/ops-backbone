FROM python:3.11-slim

WORKDIR /app

COPY agent/requirements.txt /tmp/agent-req.txt
RUN pip install --no-cache-dir -r /tmp/agent-req.txt "PyJWT>=2.9.0" "mcp>=1.0.0"

COPY agent/ /app/agent/
COPY platform/ /app/platform/

ENV PYTHONPATH=/app/platform:/app/agent
ENV CHROMA_PATH=/app/.chroma
ENV INDEX_MANIFEST_PATH=/app/.chroma/active.json

WORKDIR /app/platform
EXPOSE 8081

CMD ["python", "-m", "mcp_server.http_server"]
